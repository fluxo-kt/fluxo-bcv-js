#!/bin/sh

# SC2086: Double quote to prevent globbing and word splitting.
# shellcheck disable=SC2086

./gradlew --stop --info

# `apiDump` exists in every cell (root via BCV; checks/* via this plugin
# or KGP-embedded). `dependencyGuardBaseline` only exists where the
# `dependency-guard` plugin is applied — currently the root plugin
# module, `checks/latest`, and `checks/js-only` (NOT in `middle`,
# `kgp-only`, `dual`). Including it in COMMON would fail task selection
# in those three. Keep COMMON minimal; layer cell-specific tasks per
# block below.
COMMON_TASKS="apiDump --continue -Dlint.baselines.continue=true"
export GRADLE_OPTS="${GRADLE_OPTS} -Dorg.gradle.logging.stacktrace=all"
export GRADLE_OPTS="${GRADLE_OPTS} -Dorg.gradle.caching=false -Dkotlin.incremental=false"
export CI=true
export RELEASE=true
EXIT_CODE=0

echo ""
echo "===================================="
echo "======== RUN BASELINE TASKS ========"
echo "===================================="

# Force re-run for all the tasks
# -U: Refresh dependencies
#COMMON_TASKS="${COMMON_TASKS} --rerun-tasks -U"

# NOTE: no `kotlinUpgradeYarnLock` / `kotlinStoreYarnLock` calls below.
# The `checks/*/kotlin-js-store/yarn.lock` files are gitignored, not
# committed: bare lockfiles (no package.json) triggered 84 npm Dependabot
# alerts + daily-aborting security-update runs, while protecting nothing
# the checks assert (the `.d.ts` baselines are Kotlin-compiler-derived,
# npm-toolchain-independent). Kotlin regenerates the store per build.
# See .gitignore + AGENTS.md "Surprises & gotchas".

# Root plugin module — has dependencyGuardBaseline, plus the Detekt and
# Android Lint baseline tasks, which exist only while
# `fluxo-bcv-js/build.gradle.kts` sets `setupVerification` and
# `enableGenericAndroidLint` (fluxo-kmp-conf 0.13+ defaults both off).
./gradlew ${COMMON_TASKS} dependencyGuardBaseline detektBaselineMerge updateLintBaseline || EXIT_CODE=101

echo ""
echo "=======> checks/latest"
cd checks/latest || exit 102
pwd
# Latest cell has `dependency-guard` applied (matrix-top baseline).
./gradlew ${COMMON_TASKS} dependencyGuardBaseline || EXIT_CODE=103

echo ""
echo "=======> checks/middle"
cd ../middle || exit 107
pwd
./gradlew ${COMMON_TASKS} || EXIT_CODE=108

echo ""
echo "=======> checks/kgp-only"
cd ../kgp-only || exit 109
pwd
# Embedded-only path. Also refresh KGP's KLIB ABI baseline via
# updateKotlinAbi — distinct from this plugin's apiDump.
./gradlew ${COMMON_TASKS} updateKotlinAbi || EXIT_CODE=110

echo ""
echo "=======> checks/dual"
cd ../dual || exit 111
pwd
./gradlew ${COMMON_TASKS} || EXIT_CODE=112

echo ""
echo "=======> checks/js-only"
cd ../js-only || exit 104
pwd
# The floor cell consumes the PUBLISHED plugin (see its settings.gradle.kts),
# so publish it from the root build first. RELEASE=false: this local publish
# must not trigger Sigstore's browser-OIDC signing.
RELEASE=false ../../gradlew -p ../.. :plugin:publishAllPublicationsToChecksRepository || EXIT_CODE=113
# Gradle 7.6 runs only on Java <= 19. CI passes JDK17_HOME; locally set it,
# or on macOS it is looked up via java_home (local convenience only).
JDK17="${JDK17_HOME:-$(/usr/libexec/java_home -v 17 2>/dev/null)}"
if [ -z "${JDK17}" ]; then
  echo "checks/js-only: set JDK17_HOME to a JDK 17 home (Gradle 7.6 cannot run on newer Java)"
  exit 114
fi
# js-only also has `dependency-guard` applied (floor-cell baseline).
JAVA_HOME="${JDK17}" ./gradlew ${COMMON_TASKS} dependencyGuardBaseline || EXIT_CODE=105


# Go back to root
cd ../../ || exit 106

if [ ${EXIT_CODE} -ne 0 ]; then
  echo ""
  echo "================================"
  echo "== BASELINE TASKS FAILED: ${EXIT_CODE} =="
  echo "================================"
  exit ${EXIT_CODE}
fi
